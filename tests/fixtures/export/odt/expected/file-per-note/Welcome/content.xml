<office:text>
<text:h text:style-name="Heading_20_1" text:outline-level="1"><text:bookmark text:name="note-welcome"/>Welcome</text:h>
<text:p text:style-name="Text_20_body">This vault holds <text:span text:style-name="Strong_20_Emphasis">sample notes</text:span> for the exporters, with <text:span text:style-name="Emphasis">emphasis</text:span>, <text:span text:style-name="Strikethrough">strikethrough</text:span> and <text:span text:style-name="Source_20_Text">inline code</text:span>. A line ends here<text:line-break/>with a hard break.</text:p>
<text:h text:style-name="Heading_20_2" text:outline-level="2">Links</text:h>
<text:list text:style-name="Bullets">
<text:list-item>
<text:p text:style-name="List_20_Contents">A page on the web: <text:a xlink:type="simple" xlink:href="https://github.com/oe1wkl/schnipsle" text:style-name="Internet_20_link" text:visited-style-name="Internet_20_link">Schnipsle</text:a></text:p>
</text:list-item>
<text:list-item>
<text:p text:style-name="List_20_Contents">An address: <text:a xlink:type="simple" xlink:href="mailto:club@example.org" text:style-name="Internet_20_link" text:visited-style-name="Internet_20_link">write to the club</text:a></text:p>
</text:list-item>
<text:list-item>
<text:p text:style-name="List_20_Contents">A bare one: <text:a xlink:type="simple" xlink:href="http://www.example.org" text:style-name="Internet_20_link" text:visited-style-name="Internet_20_link">www.example.org</text:a> and <text:a xlink:type="simple" xlink:href="https://example.org/qrp" text:style-name="Internet_20_link" text:visited-style-name="Internet_20_link">https://example.org/qrp</text:a></text:p>
</text:list-item>
<text:list-item>
<text:p text:style-name="List_20_Contents">A footnote.<text:note text:id="ftn1" text:note-class="footnote"><text:note-citation>1</text:note-citation><text:note-body><text:p text:style-name="Footnote">Footnotes go to the end of the note.</text:p>
</text:note-body></text:note></text:p>
</text:list-item>
</text:list>
<text:h text:style-name="Heading_20_3" text:outline-level="3">Tags in the text</text:h>
<text:p text:style-name="Text_20_body">Tags such as #radio and #projects/tuner stay text in an export.</text:p>
</office:text>
