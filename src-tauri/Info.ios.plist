<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Merged by the Tauri CLI into the generated iOS Info.plist on every build.

  UIApplicationSceneManifest: iOS 27 refuses to launch apps built with its SDK
  that do not use the UIScene life cycle. tao >= 0.37 provides the scene
  delegate itself, so no configuration list is needed here.
  UIApplicationSupportsMultipleScenes must be true; with false, tao's startup
  runs twice and the app aborts.
  See https://github.com/tauri-apps/tao/issues/1340

  NSUbiquitousContainers: iCloud Drive shows the Documents folder of the app's
  iCloud container as "Schnipsle" (ADR-0048, docs/spikes/icloud-container.md).
  UIFileSharingEnabled and LSSupportsOpeningDocumentsInPlace: the app's local
  Documents folder shows in Files under "On My iPhone", for the default vault
  without iCloud Drive.
-->
<plist version="1.0">
<dict>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<true/>
	</dict>
	<key>NSUbiquitousContainers</key>
	<dict>
		<key>iCloud.cc.kraml.schnipsle</key>
		<dict>
			<key>NSUbiquitousContainerIsDocumentScopePublic</key>
			<true/>
			<key>NSUbiquitousContainerName</key>
			<string>Schnipsle</string>
			<key>NSUbiquitousContainerSupportedFolderLevels</key>
			<string>Any</string>
		</dict>
	</dict>
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
</dict>
</plist>
