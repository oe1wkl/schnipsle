# Development tools for Schnipsle on macOS. Install with:  brew bundle
# Xcode itself comes from the App Store (see docs/dev-setup.md).

brew "rustup"       # Rust toolchain manager; the version is pinned in rust-toolchain.toml
brew "fnm"          # Node version manager; reads .nvmrc
brew "pnpm"         # JavaScript package manager; the version is pinned in package.json
brew "cocoapods"    # required by Tauri for iOS builds
brew "git"
brew "gh"           # GitHub CLI: pull requests, issues
brew "lefthook"     # git hooks: format and lint before commit
brew "cargo-deny"   # dependency licence and advisory checks
brew "pandoc"       # optional desktop exporter (ADR-0010)
brew "typst"        # optional PDF engine for the Pandoc exporter

# Editor (optional; any editor works)
# cask "visual-studio-code"
